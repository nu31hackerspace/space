{
    "name": "nuxt-app",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "preinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:lint": "npm run format && npm run lint:fix",
        "backend:dev": "npm --prefix backend run dev",
        "backend:build": "npm --prefix backend run build",
        "backend:test": "npm --prefix backend run test"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.0",
        "@tailwindcss/vite": "^4.1.12",
        "nuxt": "^4.0.3",
        "vue": "^3.5.18",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@nuxt/eslint-config": "^1.9.0",
        "@vue/eslint-config-prettier": "^10.2.0",
        "eslint": "^9.35.0",
        "prettier": "^3.6.2",
        "tailwindcss": "^4.1.12"
    }
}
